<idea-plugin>
    <dependencies>
        <module name="azure-toolkit-for-rider.azure-intellij-plugin-lib"/>
        <module name="azure-toolkit-for-rider.azure-intellij-plugin-redis"/>
        <module name="azure-toolkit-for-rider.azure-intellij-resource-connector-lib"/>
    </dependencies>
    <extensions defaultExtensionNs="com.microsoft.tooling.msservices.intellij.azure">
        <connectorResourceType implementation="com.microsoft.azure.toolkit.intellij.redis.connection.RedisResourceDefinition"/>
        <actions implementation="com.microsoft.azure.toolkit.intellij.redis.IntellijDotnetRedisActionsContributor"/>
    </extensions>
</idea-plugin>